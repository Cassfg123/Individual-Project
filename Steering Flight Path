clear; clc; close all;
% Initial Conditions
D = 0.3;
theta0 = -0.14;
s0 = 2;
tspan = [0 100];

% Plot flight path for our given theta0, s0
y0 = [theta0,s0];flight = @(t,y) [ ((y(2)^2 - cos(y(1))) / max(y(2),1e-8)); %can add -(y(1) - atan(D))
                  -sin(y(1)) - D*y(2)^2 ];
[t,sol] = ode45(flight, tspan, y0);
th_path = sol(:,1);
s_path = sol(:,2);

% Convert from Polar to Cartesian
x = zeros(length(t),1);
y = zeros(length(t),1);
x(1) = 0; y(1) = 0;
for i = 2:length(t)
    x(i) = x(i-1) + s_path(i)*(t(i)-t(i-1))*cos(th_path(i));
    y(i) = y(i-1) + s_path(i)*(t(i)-t(i-1))*sin(th_path(i));
end

% x10 is the x-coordinate when y = -10
x10 = interp1(y,x,-10);
figure; hold on; grid on;
plot(x,y,'b','LineWidth',1.5);
plot(x10,-10,'ro','MarkerFaceColor','r','MarkerSize',10);
plot(0,0,'ko','MarkerFaceColor','k','MarkerSize',10);
ylim([-11 2]); xlim([-2 60]);  %set the graph size as fized for clearer comparison
xlabel('x'); ylabel('y');
set(gca, 'FontSize', 30);
legend('Flight Path','y = -10','Inital Position');
text(x10 - 10,-10,sprintf('(%.2f)',x10),"FontSize",25);
